{%- comment -%}
  Section: Ecom Banner
  Built from scratch (no Dawn components). Three parts, top to bottom:
    1. Top bar     – logo, short message, "Choose gift" button
    2. Hero        – illustration background, heading, text, "Shop now" button
    3. Bottom strip – one-line announcement
  Every piece of copy is editable in the theme customizer.
  Mobile gets its own shorter copy where the Figma design uses different text.
{%- endcomment -%}

{%- comment -%} Load order matters: base tokens/button first, then section styles. {%- endcomment -%}
{% render 'ecom-fonts' %}
{{ 'ecom-base.css' | asset_url | stylesheet_tag }}
{{ 'ecom-banner.css' | asset_url | stylesheet_tag }}

{%- if section.settings.hide_theme_header -%}
  {%- comment -%} The Figma top bar replaces the store header on this page only. {%- endcomment -%}
  <style>
    .shopify-section-group-header-group { display: none; }
  </style>
{%- endif -%}

<div class="ecom-banner">
  {%- comment -%}
    1. Top bar
    Desktop: logo | message | button in one row.
    Mobile:  hamburger + centred logo; the message and button move into a
             panel that the hamburger opens (see ecom-banner.js).
  {%- endcomment -%}
  {%- if section.settings.show_top_bar -%}
    {%- assign panel_id = 'EcomTopbarPanel-' | append: section.id -%}
    <ecom-topbar class="ecom-banner__topbar">
      <div class="ecom-banner__bar">
        <button
          type="button"
          class="ecom-banner__menu-toggle"
          aria-expanded="false"
          aria-controls="{{ panel_id }}"
          aria-label="Open menu"
          data-menu-toggle
        >
          <svg class="ecom-banner__icon-open" width="18" height="10" viewBox="0 0 18 10" aria-hidden="true" focusable="false">
            <path d="M0 .75h18M0 5h18M0 9.25h18" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <svg class="ecom-banner__icon-close" width="13" height="13" viewBox="0 0 13 13" aria-hidden="true" focusable="false">
            <path d="M.5.5l12 12M12.5.5l-12 12" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </button>

        <a href="{{ routes.root_url }}" class="ecom-banner__logo">
          {%- if section.settings.logo != blank -%}
            {{
              section.settings.logo
              | image_url: width: 400
              | image_tag: class: 'ecom-banner__logo-img', loading: 'eager', alt: shop.name
            }}
          {%- else -%}
            <span class="ecom-banner__logo-text">{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>
      </div>

      <div class="ecom-banner__panel" id="{{ panel_id }}" data-menu-panel>
        {%- if section.settings.top_text != blank -%}
          <p class="ecom-banner__topbar-text">{{ section.settings.top_text | escape }}</p>
        {%- endif -%}

        <div class="ecom-banner__topbar-actions">
          {%- if section.settings.top_button_label != blank -%}
            <a
              href="{{ section.settings.top_button_link | default: routes.all_products_collection_url }}"
              class="ecom-btn ecom-btn--light ecom-banner__topbar-btn"
            >
              <span>{{ section.settings.top_button_label | escape }}</span>
              {% render 'ecom-icon-arrow' %}
            </a>
          {%- endif -%}
        </div>
      </div>
    </ecom-topbar>
    <script src="{{ 'ecom-banner.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- comment -%} 2. Hero {%- endcomment -%}
  <div class="ecom-banner__hero">
    {%- comment -%}
      Illustration, exactly as the Figma layers:
        desktop → two frames: a full-width strip on top (1440×390)
                  and a block in the bottom-right corner (890×402)
        mobile  → one frame (686×264) under the text
    {%- endcomment -%}
    <div class="ecom-banner__media" aria-hidden="true">
      {%- if section.settings.image_top != blank -%}
        {{
          section.settings.image_top
          | image_url: width: 2880
          | image_tag:
            class: 'ecom-banner__bg ecom-banner__bg--top',
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '1440, 1920, 2880',
            alt: ''
        }}
      {%- endif -%}
      {%- if section.settings.image_bottom != blank -%}
        {{
          section.settings.image_bottom
          | image_url: width: 1780
          | image_tag:
            class: 'ecom-banner__bg ecom-banner__bg--bottom',
            loading: 'eager',
            sizes: '62vw',
            widths: '890, 1335, 1780',
            alt: ''
        }}
      {%- endif -%}
      {%- if section.settings.image_mobile != blank -%}
        {{
          section.settings.image_mobile
          | image_url: width: 1372
          | image_tag: class: 'ecom-banner__bg ecom-banner__bg--mobile', loading: 'eager', alt: ''
        }}
      {%- endif -%}
    </div>

    <div class="ecom-banner__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="ecom-banner__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="ecom-banner__text ecom-banner__text--desktop">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- assign mobile_text = section.settings.text_mobile | default: section.settings.text -%}
      {%- if mobile_text != blank -%}
        <p class="ecom-banner__text ecom-banner__text--mobile">{{ mobile_text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="ecom-btn ecom-btn--dark ecom-banner__cta"
        >
          <span>{{ section.settings.button_label | escape }}</span>
          {% render 'ecom-icon-arrow' %}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} 3. Bottom strip {%- endcomment -%}
  {%- if section.settings.strip_text != blank -%}
    {%- assign strip_mobile = section.settings.strip_text_mobile | default: section.settings.strip_text -%}
    <div class="ecom-banner__strip">
      <p class="ecom-banner__strip-text ecom-banner__strip-text--desktop">{{ section.settings.strip_text | escape }}</p>
      <p class="ecom-banner__strip-text ecom-banner__strip-text--mobile">{{ strip_mobile | escape }}</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Ecom Banner",
  "tag": "section",
  "class": "ecom-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "checkbox",
      "id": "show_top_bar",
      "label": "Show top bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_theme_header",
      "label": "Hide store header on this page",
      "info": "The top bar replaces the store header, as in the design.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Shown 19px tall. Falls back to the store name."
    },
    {
      "type": "text",
      "id": "top_text",
      "label": "Top bar text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_label",
      "label": "Top bar button label",
      "default": "Choose gift"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top bar button link"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "image_top",
      "label": "Illustration – top strip (desktop)",
      "info": "1440 × 390px. Figma layer: Frame at the top of the hero."
    },
    {
      "type": "image_picker",
      "id": "image_bottom",
      "label": "Illustration – bottom right (desktop)",
      "info": "890 × 402px. Figma layer: Frame in the bottom-right corner."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Illustration (mobile)",
      "info": "686 × 264px"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "textarea",
      "id": "text_mobile",
      "label": "Text on mobile",
      "info": "Leave empty to use the text above.",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Bottom strip"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "text",
      "id": "strip_text_mobile",
      "label": "Text on mobile",
      "info": "Leave empty to use the text above.",
      "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    }
  ],
  "presets": [
    {
      "name": "Ecom Banner"
    }
  ]
}
{% endschema %}
