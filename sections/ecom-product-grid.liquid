{%- comment -%}
  Section: Ecom Product Grid
  Built from scratch (no Dawn components).
  - Up to 6 blocks, each one a product picked in the customizer.
  - Each tile shows an image and a "+" hotspot (position editable per block).
  - Clicking the hotspot opens one shared quick-view popup.
  - Product data is printed as JSON inside each tile, so opening the popup
    needs no network request. Options and variants are rendered by JS.
  - Bonus rule: adding a variant that has every "trigger value" (default:
    Black + Medium) also adds the bonus product (Soft Winter Jacket).
{%- endcomment -%}

{%- comment -%} Load order matters: base tokens/button first, then section styles. {%- endcomment -%}
{% render 'ecom-fonts' %}
{{ 'ecom-base.css' | asset_url | stylesheet_tag }}
{{ 'ecom-product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ecom-product-grid.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign bonus_variant = section.settings.bonus_product.selected_or_first_available_variant
  assign popup_id = 'EcomPopup-' | append: section.id
-%}

<ecom-product-grid
  class="ecom-grid"
  data-section-id="{{ section.id }}"
  data-cart-add-url="{{ routes.cart_add_url }}.js"
  data-money-format="{{ shop.money_format | escape }}"
  data-bonus-variant-id="{{ bonus_variant.id }}"
  data-trigger-values="{{ section.settings.trigger_values | escape }}"
>
  <div class="ecom-grid__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="ecom-grid__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="ecom-grid__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign tile_image = block.settings.image | default: product.featured_image
        -%}
        <li
          class="ecom-grid__item"
          style="--hotspot-x: {{ block.settings.hotspot_x }}%; --hotspot-y: {{ block.settings.hotspot_y }}%;"
          {{ block.shopify_attributes }}
        >
          {%- if tile_image != blank -%}
            {{
              tile_image
              | image_url: width: 900
              | image_tag:
                class: 'ecom-grid__image',
                loading: 'lazy',
                widths: '345, 450, 690, 900',
                sizes: '(min-width: 1440px) 433px, (min-width: 750px) 31vw, 50vw'
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'ecom-grid__image ecom-grid__image--placeholder' }}
          {%- endif -%}

          {%- if product != blank -%}
            <button
              type="button"
              class="ecom-grid__hotspot"
              data-open-popup
              aria-haspopup="dialog"
              aria-controls="{{ popup_id }}"
              aria-label="Quick view: {{ product.title | escape }}"
            >
              <svg viewBox="0 0 22 22" aria-hidden="true" focusable="false">
                <circle cx="11" cy="11" r="11" fill="#fff"/>
                <path d="M11 6.5v9M6.5 11h9" stroke="#000" stroke-width="1.2"/>
              </svg>
            </button>
            <script type="application/json" data-product-json>{{ product | json }}</script>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  {%- comment -%} Shared quick-view popup. Filled in by ecom-product-grid.js {%- endcomment -%}
  <div class="ecom-popup" id="{{ popup_id }}" data-popup hidden>
    <div class="ecom-popup__overlay" data-close-popup></div>

    <div
      class="ecom-popup__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="{{ popup_id }}-title"
      tabindex="-1"
      data-popup-dialog
    >
      <button type="button" class="ecom-popup__close" data-close-popup aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
          <path d="M1 1l12 12M13 1 1 13" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>

      <div class="ecom-popup__header">
        <div class="ecom-popup__media">
          <img class="ecom-popup__image" data-popup-image alt="" width="120" height="140" hidden>
        </div>
        <div class="ecom-popup__info">
          <h3 class="ecom-popup__title" id="{{ popup_id }}-title" data-popup-title></h3>
          <p class="ecom-popup__price" data-popup-price></p>
          <p class="ecom-popup__description" data-popup-description></p>
        </div>
      </div>

      <div class="ecom-popup__options" data-popup-options></div>

      <p class="ecom-popup__error" data-popup-error role="alert" hidden></p>

      <button type="button" class="ecom-btn ecom-popup__atc" data-add-to-cart>
        <span data-atc-label>Add to cart</span>
        {% render 'ecom-icon-arrow' %}
      </button>
    </div>
  </div>
</ecom-product-grid>

{% schema %}
{
  "name": "Ecom Product Grid",
  "tag": "section",
  "class": "ecom-grid-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "header",
      "content": "Bonus product"
    },
    {
      "type": "product",
      "id": "bonus_product",
      "label": "Bonus product",
      "info": "Added to the cart automatically together with a variant that has all trigger values. Choose the Soft Winter Jacket."
    },
    {
      "type": "text",
      "id": "trigger_values",
      "label": "Trigger values",
      "info": "Comma-separated option values. All of them must be selected.",
      "default": "Black, Medium"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile image",
          "info": "Optional. Uses the product's featured image when empty."
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position (desktop)",
          "min": 0,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 59
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position (desktop)",
          "min": 0,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 54
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ecom Product Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
